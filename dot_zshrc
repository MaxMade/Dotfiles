###################
# Key Definitions #
###################

typeset -g -A key
key[Backspace]="^?"
key[Delete]="^[[3~"
key[Ctrl-Space]="^@"
key[Ctrl-k]="^K"
key[Ctrl-j]="^J"

###########
# Exports #
###########

# Man pages in vim, falling back to neovim, then the default pager
if (( $+commands[vim] )); then
    export MANPAGER="vim -M +MANPAGER -"
elif (( $+commands[nvim] )); then
    export MANPAGER="nvim +Man!"
fi

####################
# Generic settings #
####################

setopt extendedglob

##############
# Keybinding #
##############

# Use vi Mode
bindkey -v

# Delete
bindkey -M vicmd -- "${key[Delete]}" delete-char
bindkey -M viins -- "${key[Delete]}" delete-char

# Backspace
bindkey -M vicmd -- "${key[Backspace]}" backward-delete-char
bindkey -M viins -- "${key[Backspace]}" backward-delete-char

# Vim-like deletion
bindkey '^W' backward-kill-word
bindkey '^U' backward-kill-line
bindkey '^H' backward-delete-char
WORDCHARS=''

export KEYTIMEOUT=1

autoload -Uz edit-command-line
zle -N edit-command-line
bindkey -M vicmd n edit-command-line

################
# History file #
################

HISTFILE=~/.zsh_history
setopt hist_ignore_all_dups
setopt incappendhistory
setopt histignorespace
HISTSIZE=10000
SAVEHIST=10000

#########
# Alias #
#########

alias ls="ls --color=auto --human-readable"
alias sl="ls --color=auto --human-readable"
alias la="ls --color=auto --human-readable -la"
alias ..="cd .."
alias less="less -R"

##################
# Tab Completion #
##################

zmodload zsh/complist
autoload -Uz compinit
compinit

zstyle ":completion:*" menu select
bindkey -M menuselect "h" vi-backward-char
bindkey -M menuselect "k" vi-up-line-or-history
bindkey -M menuselect "l" vi-forward-char
bindkey -M menuselect "j" vi-down-line-or-history

#############
# Functions #
#############

# "git graph" opens tig (falls back to git log if tig is missing)
git() {
    if [[ $1 == graph ]]; then
        if (( $+commands[tig] )); then
            tig --all
        else
            command git log --graph --oneline --decorate --all
        fi
    else
        command git "$@"
    fi
}

# cheat python reverse list -> cht.sh/python/reverse+list
# Fetch with curl, falling back to wget; page with less, falling back to more
cheat() {
    local -a fetch pager
    if (( $+commands[curl] )); then
        fetch=(curl -s)
    elif (( $+commands[wget] )); then
        fetch=(wget -qO-)
    else
        echo "cheat: curl or wget is required" >&2
        return 1
    fi
    if (( $+commands[less] )); then
        pager=(less -R)
    else
        pager=(more)
    fi

    local topic=$1; (( $# )) && shift
    $fetch "https://cht.sh/$topic${*:+/${(j:+:)@}}" | $pager
}

