###########
# Helpers #
###########

# True if the command is installed
_rc_have() {
    (( $+commands[$1] ))
}

# Sets $REPLY to the first argument that is an existing file.
# The caller sources it: a file sourced inside a function would turn
# the variables it declares into locals of that function.
_rc_find_file() {
    local file
    for file; do
        [[ -f $file ]] && { REPLY=$file; return 0 }
    done
    return 1
}

###############
# Environment #
###############

# Man pages in vim, falling back to neovim, then the default pager
if _rc_have vim; then
    export MANPAGER="vim -M +MANPAGER -"
elif _rc_have nvim; then
    export MANPAGER="nvim +Man!"
fi

#################
# Shell Options #
#################

setopt extendedglob

###########
# History #
###########

HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt hist_ignore_all_dups   # keep only the newest copy of a command
setopt hist_ignore_space      # don't save commands starting with a space
setopt inc_append_history     # save each command right away

################
# Key Bindings #
################

# Vi mode, with a 10 ms timeout for multi-key sequences (fast Esc)
bindkey -v
KEYTIMEOUT=1

# Delete and Backspace
for keymap in viins vicmd; do
    bindkey -M $keymap '^[[3~' delete-char
    bindkey -M $keymap '^?'    backward-delete-char
done

# Vim-like deletion in insert mode (Ctrl+W stops at punctuation)
bindkey -M viins '^W' backward-kill-word
bindkey -M viins '^U' backward-kill-line
bindkey -M viins '^H' backward-delete-char
WORDCHARS=''

# History: Ctrl+K/J search for lines starting with what's typed,
# Ctrl+R searches anywhere (both replaced by plugins when installed)
for keymap in viins vicmd; do
    bindkey -M $keymap '^K' history-beginning-search-backward
    bindkey -M $keymap '^J' history-beginning-search-forward
    bindkey -M $keymap '^R' history-incremental-pattern-search-backward
done
unset keymap

# n in normal mode: edit the command line in $EDITOR
autoload -Uz edit-command-line
zle -N edit-command-line
bindkey -M vicmd n edit-command-line

################
# Cursor Shape #
################

# Beam in insert mode, block in normal mode
autoload -Uz add-zle-hook-widget
_rc_cursor_shape() {
    if [[ $KEYMAP == vicmd ]]; then
        echo -ne '\e[1 q'
    else
        echo -ne '\e[5 q'
    fi
}
add-zle-hook-widget line-init     _rc_cursor_shape
add-zle-hook-widget keymap-select _rc_cursor_shape

##############
# Completion #
##############

zmodload zsh/complist
autoload -Uz compinit
compinit

# Menu selection, navigated with h/j/k/l
zstyle ':completion:*' menu select
bindkey -M menuselect h vi-backward-char
bindkey -M menuselect j vi-down-line-or-history
bindkey -M menuselect k vi-up-line-or-history
bindkey -M menuselect l vi-forward-char

###########
# Aliases #
###########

alias ls="ls --color=auto --human-readable"
alias sl="ls --color=auto --human-readable"
alias la="ls --color=auto --human-readable -la"
alias ..="cd .."
alias less="less -R"

#############
# Functions #
#############

# "git graph" opens tig (falls back to git log if tig is missing)
git() {
    if [[ $1 != graph ]]; then
        command git "$@"
    elif _rc_have tig; then
        tig --all
    else
        command git log --graph --oneline --decorate --all
    fi
}

# cheat python reverse list -> cht.sh/python/reverse+list
# Fetches with curl or wget, pages with less or more
cheat() {
    local -a fetch pager
    if _rc_have curl; then
        fetch=(curl -s)
    elif _rc_have wget; then
        fetch=(wget -qO-)
    else
        echo "cheat: curl or wget is required" >&2
        return 1
    fi
    if _rc_have less; then
        pager=(less -R)
    else
        pager=(more)
    fi

    local topic=$1
    (( $# )) && shift
    local query=${(j:+:)@}
    "${fetch[@]}" "https://cht.sh/$topic${query:+/$query}" | "${pager[@]}"
}

###################
# SSH Agent (GPG) #
###################

if _rc_have gpgconf; then
    unset SSH_AGENT_PID
    if (( ${gnupg_SSH_AUTH_SOCK_by:-0} != $$ )); then
        export SSH_AUTH_SOCK=$(gpgconf --list-dirs agent-ssh-socket)
    fi
    export GPG_TTY=$TTY
    gpg-connect-agent updatestartuptty /bye >/dev/null 2>&1
fi

###########
# Plugins #
###########
# Each plugin is optional and skipped when not installed.
# Paths: Arch first, Debian second.
# Order matters: syntax highlighting after all other widgets,
# history substring search after syntax highlighting.

# fzf: fuzzy Ctrl+R (history), Ctrl+T (files), Alt+C (directories)
if _rc_have fzf; then
    if fzf_init=$(fzf --zsh 2>/dev/null); then    # fzf 0.48 and newer
        eval "$fzf_init"
    elif _rc_find_file \
        /usr/share/fzf/key-bindings.zsh \
        /usr/share/doc/fzf/examples/key-bindings.zsh
    then
        source "$REPLY"
        [[ -f ${REPLY:h}/completion.zsh ]] && source "${REPLY:h}/completion.zsh"
    fi
    unset fzf_init
fi

# Suggest installing the package that provides an unknown command
if _rc_find_file \
    /usr/share/doc/pkgfile/command-not-found.zsh \
    /etc/zsh_command_not_found
then
    source "$REPLY"
fi

# Autosuggestions from history; Ctrl+Space accepts and runs one
if _rc_find_file \
    /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh \
    /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh
then
    source "$REPLY"
    ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=#666666'
    for keymap in viins vicmd; do
        bindkey -M $keymap '^@' autosuggest-execute
    done
    unset keymap
fi

# Syntax highlighting
if _rc_find_file \
    /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh \
    /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
then
    source "$REPLY"
fi

# History substring search: Ctrl+K/J (and k/j in normal mode) match
# anywhere in the line instead of only at the start
if _rc_find_file \
    /usr/share/zsh/plugins/zsh-history-substring-search/zsh-history-substring-search.zsh \
    /usr/share/zsh-history-substring-search/zsh-history-substring-search.zsh
then
    source "$REPLY"
    HISTORY_SUBSTRING_SEARCH_HIGHLIGHT_FOUND=none
    HISTORY_SUBSTRING_SEARCH_HIGHLIGHT_NOT_FOUND=none
    for keymap in viins vicmd; do
        bindkey -M $keymap '^K' history-substring-search-up
        bindkey -M $keymap '^J' history-substring-search-down
    done
    unset keymap
    bindkey -M vicmd k history-substring-search-up
    bindkey -M vicmd j history-substring-search-down
fi

##########
# Prompt #
##########

# Starship (config: ~/.config/starship.toml)
if _rc_have starship; then
    eval "$(starship init zsh)"

# Fallback with the same layout and colors, without git, duration,
# exit code and read-only marker: user@host [ssh] dir $
else
    PS1='%(!.%F{red}.%F{green})%n%F{blue}@%F{green}%m'   # red user for root
    [[ -n $SSH_CONNECTION ]] && PS1+='%F{blue} [ssh]'
    PS1+=' %F{blue}%2~ %F{green}$%f '
fi

