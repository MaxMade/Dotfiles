# Beam in insert mode, block in normal mode
autoload -Uz add-zle-hook-widget
_cursor_shape() {
    if [[ $KEYMAP == vicmd ]]; then
        echo -ne "\e[1 q"
    else
        echo -ne "\e[5 q"
    fi
}
add-zle-hook-widget line-init _cursor_shape
add-zle-hook-widget keymap-select _cursor_shape

##########
# Prompt #
##########

# Extra lines only appear when relevant:
#   Duration: 3s          <- commands longer than 2s
#   Exit Code: 130        <- failed commands
# user@host ~/dir (main?+-!) $

setopt prompt_subst
zmodload zsh/datetime
autoload -Uz add-zsh-hook

# Git: (branch, new ?, modified +, deleted -, staged !)
_prompt_git_info() {
    _prompt_git=
    (( $+commands[git] )) || return
    local out
    out=$(command git --no-optional-locks status --porcelain --branch 2>/dev/null) || return

    local -a lines=("${(@f)out}")
    local branch=${lines[1]#\#\# }
    branch=${branch#No commits yet on }
    branch=${branch%%...*}
    branch=${branch% (no branch)}

    local line x y new= modified= deleted= staged=
    for line in "${(@)lines[2,-1]}"; do
        x=${line[1]} y=${line[2]}
        [[ $x$y == '??' ]] && { new='?'; continue }
        [[ $x == A ]] && new='?'
        [[ $y == [MT] ]] && modified='+'
        [[ $x == D || $y == D ]] && deleted='-'
        [[ $x == [MTADRC] ]] && staged='!'
    done

    _prompt_git="%F{yellow}(${branch//\%/%%}$new$modified$deleted$staged)%f "
}

_prompt_preexec() {
    _prompt_start=$EPOCHREALTIME
}

_prompt_precmd() {
    local exit=$?

    # Duration line (only for commands longer than 2s)
    if [[ -n $_prompt_start ]]; then
        local -i ms=$(( (EPOCHREALTIME - _prompt_start) * 1000 ))
        unset _prompt_start
        if (( ms >= 2000 )); then
            local -i s=$(( ms / 1000 ))
            local -i d=$(( s / 86400 )) h=$(( s % 86400 / 3600 )) m=$(( s % 3600 / 60 ))
            local dur=
            (( d )) && dur+="${d}d"
            (( d || h )) && dur+="${h}h"
            (( d || h || m )) && dur+="${m}m"
            dur+="$(( s % 60 ))s"
            print -P "%F{yellow}  Duration: $dur%f"
        fi
    fi

    # Exit code line (only on failure)
    (( exit )) && print -P "%F{red}  Exit Code: $exit%f"

    # Lock icon for read-only directories
    [[ -w $PWD ]] && _prompt_ro= || _prompt_ro='%F{red} 🔒%f'

    _prompt_git_info
}

add-zsh-hook preexec _prompt_preexec
add-zsh-hook precmd _prompt_precmd

# user@host (hostname underlined over SSH)
PS1='%F{green}%n%f%F{blue}@%f'
if [[ -n $SSH_CONNECTION ]]; then
    PS1+='%F{green}%U%M%u%f '
else
    PS1+='%F{green}%M%f '
fi

# ~/dir (git) $
PS1+='%F{blue}%2~%f${_prompt_ro} ${_prompt_git}%F{green}$%f '
RPS1=

###################
# SSH Agent (GPG) #
###################

if (( $+commands[gpgconf] )); then
    unset SSH_AGENT_PID
    if [ "${gnupg_SSH_AUTH_SOCK_by:-0}" -ne $$ ]; then
        export SSH_AUTH_SOCK="$(gpgconf --list-dirs agent-ssh-socket)"
    fi
    export GPG_TTY=$TTY
    gpg-connect-agent updatestartuptty /bye >/dev/null 2>&1
fi

###########
# Plugins #
###########
# Kept last: zsh-syntax-highlighting must be sourced after all widgets,
# and history-substring-search after zsh-syntax-highlighting.
# Paths: Arch first, Debian second. Missing plugins are skipped.

# fzf (fzf >= 0.48 provides its own init, older versions ship scripts)
if (( $+commands[fzf] )); then
    if FZF_INIT=$(fzf --zsh 2>/dev/null); then
        eval "$FZF_INIT"
    else
        for PATH_FZF in "/usr/share/fzf" "/usr/share/doc/fzf/examples"
        do
            if [[ -f $PATH_FZF/key-bindings.zsh ]]; then
                source $PATH_FZF/key-bindings.zsh
                [[ -f $PATH_FZF/completion.zsh ]] && source $PATH_FZF/completion.zsh
                break
            fi
        done
    fi
    unset FZF_INIT
fi

# Without fzf: Ctrl+R falls back to zsh's built-in incremental history search
if (( ! $+widgets[fzf-history-widget] )); then
    bindkey -M viins '^R' history-incremental-pattern-search-backward
    bindkey -M vicmd '^R' history-incremental-pattern-search-backward
fi

# Command not found hook (Arch: pkgfile, Debian: command-not-found)
if [[ -f /usr/share/doc/pkgfile/command-not-found.zsh ]]; then
    source /usr/share/doc/pkgfile/command-not-found.zsh
elif [[ -f /etc/zsh_command_not_found ]]; then
    source /etc/zsh_command_not_found
fi

# Autosuggestions
for PATH_AUTOSUGGEST in "/usr/share/zsh/plugins/zsh-autosuggestions" "/usr/share/zsh-autosuggestions"
do
    if [[ -f $PATH_AUTOSUGGEST/zsh-autosuggestions.zsh ]]; then
        source $PATH_AUTOSUGGEST/zsh-autosuggestions.zsh

        bindkey -M vicmd -- "${key[Ctrl-Space]}" autosuggest-execute
        bindkey -M viins -- "${key[Ctrl-Space]}" autosuggest-execute

        ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg=#666666"

        break
    fi
done

# Syntax highlighting
for PATH_SYNTAX in "/usr/share/zsh/plugins/zsh-syntax-highlighting" "/usr/share/zsh-syntax-highlighting"
do
    if [[ -f $PATH_SYNTAX/zsh-syntax-highlighting.zsh ]]; then
        source $PATH_SYNTAX/zsh-syntax-highlighting.zsh
        break
    fi
done

# Substring history search (fallback: built-in prefix search)
for PATH_SUBSTRING in "/usr/share/zsh/plugins/zsh-history-substring-search" "/usr/share/zsh-history-substring-search"
do
    if [[ -f $PATH_SUBSTRING/zsh-history-substring-search.zsh ]]; then
        source $PATH_SUBSTRING/zsh-history-substring-search.zsh
        break
    fi
done

if (( $+widgets[history-substring-search-up] )); then
    bindkey -M vicmd "k" history-substring-search-up
    bindkey -M vicmd "j" history-substring-search-down

    bindkey -M viins -- "${key[Ctrl-k]}" history-substring-search-up
    bindkey -M vicmd -- "${key[Ctrl-k]}" history-substring-search-up
    bindkey -M viins -- "${key[Ctrl-j]}" history-substring-search-down
    bindkey -M vicmd -- "${key[Ctrl-j]}" history-substring-search-down

    HISTORY_SUBSTRING_SEARCH_HIGHLIGHT_FOUND=none
    HISTORY_SUBSTRING_SEARCH_HIGHLIGHT_NOT_FOUND=none
else
    bindkey -M viins -- "${key[Ctrl-k]}" history-beginning-search-backward
    bindkey -M vicmd -- "${key[Ctrl-k]}" history-beginning-search-backward
    bindkey -M viins -- "${key[Ctrl-j]}" history-beginning-search-forward
    bindkey -M vicmd -- "${key[Ctrl-j]}" history-beginning-search-forward
fi

