# Only for interactive shells (scp, rsync etc. also read this file)
[[ $- == *i* ]] || return

###########
# Helpers #
###########

# True if the command is installed
_rc_have() {
    type -P "$1" >/dev/null
}

# Sets $REPLY to the first argument that is an existing file.
# The caller sources it: a file sourced inside a function would turn
# the variables it declares into locals of that function.
_rc_find_file() {
    local file
    for file; do
        [[ -f $file ]] && { REPLY=$file; return 0; }
    done
    return 1
}

###############
# Environment #
###############

# Man pages in vim, falling back to neovim, then the default pager
if _rc_have vim; then
    export MANPAGER="vim -M +MANPAGER -"
elif _rc_have nvim; then
    export MANPAGER="nvim +Man!"
fi

#################
# Shell Options #
#################

shopt -s extglob

###########
# History #
###########

HISTFILE=~/.bash_history
HISTSIZE=10000
HISTFILESIZE=10000
HISTCONTROL=ignorespace:erasedups   # no space-prefixed lines, newest copy only
shopt -s histappend                 # append to the file instead of overwriting

################
# Key Bindings #
################

# Vi mode, with a 10 ms timeout for multi-key sequences (fast Esc)
set -o vi
bind 'set keyseq-timeout 10'

# Vim-like deletion in insert mode (Ctrl+W stops at punctuation)
bind -m vi-insert '"\C-w": backward-kill-word'
bind -m vi-insert '"\C-u": unix-line-discard'
bind -m vi-insert '"\C-h": backward-delete-char'

# History: Ctrl+K/J search for lines starting with what's typed,
# Ctrl+R searches anywhere (replaced by fzf when installed)
for keymap in vi-insert vi-command; do
    bind -m $keymap '"\C-k": history-search-backward'
    bind -m $keymap '"\C-j": history-search-forward'
    bind -m $keymap '"\C-r": reverse-search-history'
done
unset keymap

################
# Cursor Shape #
################

# Beam in insert mode, block in normal mode
bind 'set show-mode-in-prompt on'
bind 'set vi-ins-mode-string \1\e[5 q\2'
bind 'set vi-cmd-mode-string \1\e[1 q\2'

##############
# Completion #
##############

# bash-completion, unless the system bashrc already loaded it
# (Arch does, Debian leaves it to ~/.bashrc)
if [[ -z ${BASH_COMPLETION_VERSINFO-} ]] && ! shopt -oq posix && _rc_find_file \
    /usr/share/bash-completion/bash_completion \
    /etc/bash_completion
then
    source "$REPLY"
fi

# Characters that split words for completion
export COMP_WORDBREAKS=$' \t\n"\'@><=;|&(:'

###########
# Aliases #
###########

alias ls="ls --color=auto --human-readable"
alias sl="ls --color=auto --human-readable"
alias la="ls --color=auto --human-readable -la"
alias ..="cd .."
alias less="less -R"

#############
# Functions #
#############

# "git graph" opens tig (falls back to git log if tig is missing)
git() {
    if [[ $1 != graph ]]; then
        command git "$@"
    elif _rc_have tig; then
        tig --all
    else
        command git log --graph --oneline --decorate --all
    fi
}

# cheat python reverse list -> cht.sh/python/reverse+list
# Fetches with curl or wget, pages with less or more
cheat() {
    local -a fetch pager
    if _rc_have curl; then
        fetch=(curl -s)
    elif _rc_have wget; then
        fetch=(wget -qO-)
    else
        echo "cheat: curl or wget is required" >&2
        return 1
    fi
    if _rc_have less; then
        pager=(less -R)
    else
        pager=(more)
    fi

    local topic=$1
    (( $# )) && shift
    local query
    query=$(IFS=+; echo "$*")
    "${fetch[@]}" "https://cht.sh/$topic${query:+/$query}" | "${pager[@]}"
}

###################
# SSH Agent (GPG) #
###################

if _rc_have gpgconf; then
    unset SSH_AGENT_PID
    if (( ${gnupg_SSH_AUTH_SOCK_by:-0} != $$ )); then
        export SSH_AUTH_SOCK=$(gpgconf --list-dirs agent-ssh-socket)
    fi
    export GPG_TTY=$(tty)
    gpg-connect-agent updatestartuptty /bye >/dev/null 2>&1
fi

###########
# Plugins #
###########
# Each plugin is optional and skipped when not installed.
# Paths: Arch first, Debian second.

# fzf: fuzzy Ctrl+R (history), Ctrl+T (files), Alt+C (directories)
if _rc_have fzf; then
    if fzf_init=$(fzf --bash 2>/dev/null); then   # fzf 0.48 and newer
        eval "$fzf_init"
    elif _rc_find_file \
        /usr/share/fzf/key-bindings.bash \
        /usr/share/doc/fzf/examples/key-bindings.bash
    then
        source "$REPLY"
        [[ -f ${REPLY%/*}/completion.bash ]] && source "${REPLY%/*}/completion.bash"
    fi
    unset fzf_init
fi

# Suggest installing the package that provides an unknown command
# (Debian's system bashrc sets this up already)
if [[ -f /usr/share/doc/pkgfile/command-not-found.bash ]]; then
    source /usr/share/doc/pkgfile/command-not-found.bash
elif [[ -x /usr/lib/command-not-found ]] && ! declare -F command_not_found_handle >/dev/null; then
    command_not_found_handle() {
        /usr/lib/command-not-found -- "$1"
        return 127
    }
fi

##########
# Prompt #
##########
# Kept last: starship adds itself to PROMPT_COMMAND and should come
# after anything else that changes it.

# Starship (config: ~/.config/starship.toml)
if _rc_have starship; then
    eval "$(starship init bash)"

# Fallback with the same layout and colors, without git, duration,
# exit code and read-only marker: user@host [ssh] dir $
else
    # Last two path components, with ~ for home (like zsh's %2~)
    _rc_prompt_dir() {
        _rc_dir=$PWD
        if [[ $PWD == "$HOME" || $PWD == "$HOME"/* ]]; then
            _rc_dir="~${PWD#"$HOME"}"
        fi
        if [[ $_rc_dir =~ ^.+/([^/]*/[^/]*)$ ]]; then
            _rc_dir=${BASH_REMATCH[1]}
        fi
    }
    PROMPT_COMMAND="_rc_prompt_dir${PROMPT_COMMAND:+; $PROMPT_COMMAND}"

    if (( EUID == 0 )); then                         # red user for root
        PS1='\[\e[31m\]'
    else
        PS1='\[\e[32m\]'
    fi
    PS1+='\u\[\e[34m\]@\[\e[32m\]\h'
    [[ -n $SSH_CONNECTION ]] && PS1+='\[\e[34m\] [ssh]'
    PS1+=' \[\e[34m\]${_rc_dir}\[\e[32m\] $\[\e[0m\] '
fi

